---
import '../styles/global.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'ko' | 'en';
  type?: 'website' | 'article';
  koUrl?: string;
  enUrl?: string;
  image?: string;
  robots?: 'noindex, follow';
}

const {
  title,
  description = 'KJH Dev Blog',
  lang = 'ko',
  type = 'website',
  koUrl,
  enUrl,
  image = '/images/og-default.png',
  robots,
} = Astro.props;

const homeUrl = lang === 'ko' ? '/' : '/en/';
const otherLangUrl = lang === 'ko' ? (enUrl ?? '/en/') : (koUrl ?? '/');
const site = Astro.site ?? new URL('https://kjhdev.github.io');
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = new URL(image, site);
const rssURL = new URL(`/${lang}/rss.xml`, site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="bolJzl6qQmXbFkaP1RzWqIlA5pugOw9Jj0N4h8_ROtY" />
    <meta name="naver-site-verification" content="db74ee1cd397ac7218cc3ca5d87cd9f32545d98a" />
    {robots && <meta name="robots" content={robots} />}
    <GoogleAnalytics />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3227222245611825" crossorigin="anonymous"></script>
    <link rel="icon" type="image/png" href="/gg.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#fcfaf1" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="KJH Dev" />
    <link rel="canonical" href={canonicalURL} />
    {koUrl && <link rel="alternate" hreflang="ko" href={new URL(koUrl, site)} />}
    {enUrl && <link rel="alternate" hreflang="en" href={new URL(enUrl, site)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content="KJH Dev" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <link rel="alternate" type="application/rss+xml" title={lang === 'ko' ? 'KJH Dev 한국어 RSS' : 'KJH Dev English RSS'} href={rssURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-title" href={homeUrl}>KJH Dev</a>
        <nav class="site-nav" aria-label={lang === 'ko' ? '주요 메뉴' : 'Main navigation'}>
          <a href={homeUrl}>{lang === 'ko' ? '홈' : 'Home'}</a>
          <a href={`/${lang}/projects/`}>{lang === 'ko' ? '프로젝트' : 'Projects'}</a>
          <a href={`/${lang}/notes/`}>{lang === 'ko' ? '개발노트' : 'Notes'}</a>
          <a href={`/${lang}/about/`}>{lang === 'ko' ? '소개' : 'About'}</a>
          <a class="language-link" href={otherLangUrl} lang={lang === 'ko' ? 'en' : 'ko'} aria-label={lang === 'ko' ? 'English' : '한국어로 보기'}>{lang === 'ko' ? 'EN' : '한국어'}</a>
        </nav>
      </div>
    </header>
    <main class="main-container"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        © 2026 KJH Dev · <a href={`/${lang}/about/`}>{lang === 'ko' ? '소개' : 'About'}</a> · <a href={`/${lang}/notes/`}>{lang === 'ko' ? '개발노트' : 'Notes'}</a> · <a href={`/${lang}/privacy/`}>{lang === 'ko' ? '개인정보처리방침' : 'Privacy'}</a>
      </div>
    </footer>
  </body>
</html>