---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'ko' | 'en';
  type?: 'website' | 'article';
  koUrl?: string;
  enUrl?: string;
}

const {
  title,
  description = 'KJH Dev Blog',
  lang = 'ko',
  type = 'website',
  koUrl,
  enUrl,
} = Astro.props;

const homeUrl = lang === 'ko' ? '/ko/' : '/en/';

const site = Astro.site ?? new URL('https://kjhdev.github.io');
const canonicalURL = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/png" href="/gg.png" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang: 실제 존재하는 번역 페이지가 전달된 경우에만 출력 -->
    {
      koUrl && (
        <link
          rel="alternate"
          hreflang="ko"
          href={new URL(koUrl, site)}
        />
      )
    }

    {
      enUrl && (
        <link
          rel="alternate"
          hreflang="en"
          href={new URL(enUrl, site)}
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="KJH Dev" />
    <meta
      property="og:locale"
      content={lang === 'ko' ? 'ko_KR' : 'en_US'}
    />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-title" href={homeUrl}>
          KJH Dev
        </a>

        <nav class="site-nav">
          <a href={homeUrl}>
            {lang === 'ko' ? '홈' : 'Home'}
          </a>

          <a href={`/${lang}/categories/`}>
            {lang === 'ko' ? '카테고리' : 'Categories'}
          </a>
        </nav>
      </div>
    </header>

    <main class="main-container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        © 2026 KJH Dev
      </div>
    </footer>
  </body>
</html>
