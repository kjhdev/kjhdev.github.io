---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'ko' | 'en';
  type?: 'website' | 'article';
}

const {
  title,
  description = 'KJH Dev Blog',
  lang = 'ko',
  type = 'website',
} = Astro.props;

const homeUrl = lang === 'ko' ? '/ko/' : '/en/';

const site = Astro.site ?? new URL('https://kjhdev.github.io');

const canonicalURL = new URL(
  Astro.url.pathname,
  site
);

const koPath =
  lang === 'ko'
    ? Astro.url.pathname
    : Astro.url.pathname.replace(/^\/en(?=\/|$)/, '/ko');

const enPath =
  lang === 'en'
    ? Astro.url.pathname
    : Astro.url.pathname.replace(/^\/ko(?=\/|$)/, '/en');

const koURL = new URL(koPath, site);
const enURL = new URL(enPath, site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/png" href="/gg.png" />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <!-- Canonical -->
    <link
      rel="canonical"
      href={canonicalURL}
    />

    <!-- 한글 / 영어 페이지 연결 -->
    <link
      rel="alternate"
      hreflang="ko"
      href={koURL}
    />

    <link
      rel="alternate"
      hreflang="en"
      href={enURL}
    />

    <!-- Open Graph -->
    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:type"
      content={type}
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:site_name"
      content="KJH Dev"
    />

    <meta
      property="og:locale"
      content={lang === 'ko' ? 'ko_KR' : 'en_US'}
    />

    <!-- Twitter / X -->
    <meta
      name="twitter:card"
      content="summary"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <link
      rel="sitemap"
      href="/sitemap-index.xml"
    />
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-title" href={homeUrl}>
          KJH Dev
        </a>

        <nav class="site-nav">
          <a href={homeUrl}>
            {lang === 'ko' ? '홈' : 'Home'}
          </a>

          <a href={`/${lang}/categories/`}>
            {lang === 'ko' ? '카테고리' : 'Categories'}
          </a>
        </nav>
      </div>
    </header>

    <main class="main-container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        © 2026 KJH Dev
      </div>
    </footer>
  </body>
</html>