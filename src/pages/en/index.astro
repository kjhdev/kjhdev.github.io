---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { extractFirstPostImage } from '../../utils/postImage';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.lang === 'en' && !post.data.draft)
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
---

<BaseLayout
  title="KJH Dev"
  description="A development blog about programming, troubleshooting, and software development."
  lang="en"
  koUrl="/ko/"
  enUrl="/en/"
>
  <section class="hero">
    <h1>KJH Dev</h1>

    <p>
      Development experiences, technical notes, and solutions
      learned while building software.
    </p>
  </section>

  <section>
    <h2 class="section-title">Recent Posts</h2>

    {
      posts.length === 0 ? (
        <p>No posts yet.</p>
      ) : (
        <div class="post-list">
          {
            posts.map((post) => {
              const slug = post.id.split('/').pop();
              const thumbnail =
                post.data.postType !== 'project'
                  ? extractFirstPostImage(post.body)
                  : null;

              return (
                <a
                  class:list={['post-card', { 'has-thumbnail': !!thumbnail }]}
                  href={`/en/posts/${slug}/`}
                >
                  {thumbnail && (
                    <div class="post-card-thumbnail" aria-hidden="true">
                      <img
                        src={thumbnail}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}

                  <div class="post-card-content">
                    <h3 class="post-title">
                      {post.data.title}
                    </h3>

                    <p class="post-description">
                      {post.data.description}
                    </p>

                    <div class="post-meta">
                      {post.data.pubDate.toLocaleDateString('en-US')}
                      {
                        post.data.category &&
                        ` · ${post.data.category}`
                      }
                    </div>
                  </div>
                </a>
              );
            })
          }
        </div>
      )
    }
  </section>
</BaseLayout>
