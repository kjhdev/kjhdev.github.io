---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categoryToSlug } from '../../../utils/category';
import { extractFirstPostImage } from '../../../utils/postImage';

export function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;

if (lang !== 'ko' && lang !== 'en') {
  throw new Error('Invalid language');
}

const posts = (await getCollection('blog'))
  .filter(
    (post) =>
      post.data.lang === lang &&
      !post.data.draft &&
      post.data.postType !== 'project'
  )
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );

const categoryMap = new Map<string, number>();

for (const post of posts) {
  const category = post.data.category;
  if (!category) continue;
  categoryMap.set(category, (categoryMap.get(category) ?? 0) + 1);
}

const categories = Array.from(categoryMap.entries())
  .map(([name, count]) => ({
    name,
    count,
    slug: categoryToSlug(name),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title={lang === 'ko' ? '개발노트 | KJH Dev' : 'Development Notes | KJH Dev'}
  description={
    lang === 'ko'
      ? '개발 중 마주친 문제와 해결 방법, 설정과 운영 경험을 정리한 개발노트입니다.'
      : 'Development notes covering troubleshooting, configuration, and operational experience.'
  }
  lang={lang}
>
  <section>
    <div class="category-page-header">
      <h1>{lang === 'ko' ? '개발노트' : 'Development Notes'}</h1>
      <p>
        {lang === 'ko'
          ? '특정 프로젝트에 묶이지 않는 문제 해결, 설정, 개발 팁을 기록합니다.'
          : 'Troubleshooting, configuration, and development tips that are not tied to a single project series.'}
      </p>
    </div>

    {categories.length > 0 && (
      <nav class="note-category-filter" aria-label={lang === 'ko' ? '개발노트 카테고리' : 'Development note categories'}>
        <a class="note-category-chip is-active" href={`/${lang}/notes/`}>
          {lang === 'ko' ? '전체' : 'All'}
        </a>
        {categories.map((category) => (
          <a class="note-category-chip" href={`/${lang}/notes/${category.slug}/`}>
            {category.name}
            <span>{category.count}</span>
          </a>
        ))}
      </nav>
    )}

    {
      posts.length === 0 ? (
        <p>{lang === 'ko' ? '아직 등록된 개발노트가 없습니다.' : 'No development notes yet.'}</p>
      ) : (
        <div class="post-list">
          {posts.map((post) => {
            const slug = post.id.split('/').pop();
            const thumbnail = extractFirstPostImage(post.body);

            return (
              <a
                class:list={['post-card', { 'has-thumbnail': !!thumbnail }]}
                href={`/${lang}/posts/${slug}/`}
              >
                {thumbnail && (
                  <div class="post-card-thumbnail" aria-hidden="true">
                    <img
                      src={thumbnail}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}

                <div class="post-card-content">
                  <h2 class="post-title">{post.data.title}</h2>
                  <p class="post-description">{post.data.description}</p>
                  <div class="post-meta">
                    {post.data.pubDate.toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US')}
                    {post.data.category && ` · ${post.data.category}`}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </section>
</BaseLayout>
