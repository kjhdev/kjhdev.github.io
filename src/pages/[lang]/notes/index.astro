---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;

if (lang !== 'ko' && lang !== 'en') {
  throw new Error('Invalid language');
}

const posts = (await getCollection('blog'))
  .filter(
    (post) =>
      post.data.lang === lang &&
      !post.data.draft &&
      post.data.postType !== 'project'
  )
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
---

<BaseLayout
  title={lang === 'ko' ? '개발노트 | KJH Dev' : 'Development Notes | KJH Dev'}
  description={
    lang === 'ko'
      ? '개발 중 마주친 문제와 해결 방법, 설정과 운영 경험을 정리한 개발노트입니다.'
      : 'Development notes covering troubleshooting, configuration, and operational experience.'
  }
  lang={lang}
>
  <section>
    <div class="category-page-header">
      <h1>{lang === 'ko' ? '개발노트' : 'Development Notes'}</h1>
      <p>
        {lang === 'ko'
          ? '특정 프로젝트에 묶이지 않는 문제 해결, 설정, 개발 팁을 기록합니다.'
          : 'Troubleshooting, configuration, and development tips that are not tied to a single project series.'}
      </p>
    </div>

    {
      posts.length === 0 ? (
        <p>{lang === 'ko' ? '아직 등록된 개발노트가 없습니다.' : 'No development notes yet.'}</p>
      ) : (
        <div class="post-list">
          {posts.map((post) => {
            const slug = post.id.split('/').pop();

            return (
              <a class="post-card" href={`/${lang}/posts/${slug}/`}>
                <h2 class="post-title">{post.data.title}</h2>
                <p class="post-description">{post.data.description}</p>
                <div class="post-meta">
                  {post.data.pubDate.toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US')}
                  {post.data.category && ` · ${post.data.category}`}
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </section>
</BaseLayout>
