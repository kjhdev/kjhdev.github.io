---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { projects as projectDefinitions } from '../../../data/projects';

export function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;

if (lang !== 'ko' && lang !== 'en') {
  throw new Error('Invalid language');
}

const projectPosts = (await getCollection('blog'))
  .filter(
    (post) =>
      post.data.lang === lang &&
      !post.data.draft &&
      post.data.postType === 'project'
  );

const projects = projectDefinitions.map((project) => ({
  ...project,
  postCount: projectPosts.filter((post) => post.data.project === project.id).length,
}));
---

<BaseLayout
  title={lang === 'ko' ? '프로젝트 | KJH Dev' : 'Projects | KJH Dev'}
  description={
    lang === 'ko'
      ? '실제 서비스를 설계하고 개발하며 겪은 과정을 프로젝트 단위로 정리합니다.'
      : 'Development journeys organized by real projects, from design to operation.'
  }
  lang={lang}
>
  <section>
    <div class="category-page-header">
      <h1>{lang === 'ko' ? '프로젝트' : 'Projects'}</h1>
      <p>
        {lang === 'ko'
          ? '실제 서비스를 만들면서 진행한 설계, 구현, 문제 해결 과정을 프로젝트별로 정리합니다.'
          : 'Browse complete project stories covering design, implementation, troubleshooting, and operation.'}
      </p>
    </div>

    <div class="project-grid">
      {projects.map((project) => (
        <a class="project-card" href={`/${lang}/projects/${project.id}/`}>
          <div class="project-card-meta">
            <span class="project-status">{project.status[lang]}</span>
            <span>
              {project.postCount}
              {lang === 'ko' ? '개의 글' : ' posts'}
            </span>
          </div>
          <h2>{project.title[lang]}</h2>
          <p>{project.description[lang]}</p>
          <span class="project-card-link">
            {lang === 'ko' ? '프로젝트 보기 →' : 'View project →'}
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
