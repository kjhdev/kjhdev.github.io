---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categoryToSlug } from '../../../utils/category';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: post.id.split('/').pop() },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const lang = post.data.lang as 'ko' | 'en';
const slug = post.id.split('/').pop()!;
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const koPost = allPosts.find((item) => item.data.lang === 'ko' && item.id.split('/').pop() === slug);
const enPost = allPosts.find((item) => item.data.lang === 'en' && item.id.split('/').pop() === slug);
// 시리즈는 실제 읽는 순서에 맞춰 이동하고, 일반 글은 주제·기술 태그 기준으로 연결한다.
const projectSeries = post.data.postType === 'project' && post.data.project
  ? allPosts
      .filter((item) =>
        item.data.lang === lang &&
        item.data.postType === 'project' &&
        item.data.project === post.data.project
      )
      .sort((a, b) =>
        (a.data.seriesOrder ?? Number.MAX_SAFE_INTEGER) - (b.data.seriesOrder ?? Number.MAX_SAFE_INTEGER)
        || a.data.pubDate.getTime() - b.data.pubDate.getTime()
      )
  : [];
const seriesIndex = projectSeries.findIndex((item) => item.id === post.id);
const previousProjectPost = seriesIndex > 0 ? projectSeries[seriesIndex - 1] : null;
const nextProjectPost = seriesIndex >= 0 && seriesIndex < projectSeries.length - 1
  ? projectSeries[seriesIndex + 1] : null;

const relatedPosts = post.data.postType === 'project'
  ? []
  : allPosts
      .filter((item) => item.data.lang === lang && item.id !== post.id && item.data.postType !== 'project')
      .map((item) => ({
        item,
        score: (post.data.category && item.data.category === post.data.category ? 3 : 0)
          + item.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
      }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score || b.item.data.pubDate.getTime() - a.item.data.pubDate.getTime())
      .slice(0, 3)
      .map(({ item }) => item);
const categoryHref = post.data.postType === 'project' && post.data.project
  ? `/${lang}/projects/${post.data.project}/`
  : post.data.category
    ? `/${lang}/notes/${categoryToSlug(post.data.category)}/`
    : undefined;
const formattedDate = post.data.pubDate.toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const modifiedDate = post.data.updatedDate && post.data.updatedDate.getTime() !== post.data.pubDate.getTime()
  ? post.data.updatedDate.toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US', {
      year: 'numeric', month: 'long', day: 'numeric',
    })
  : null;
const modifiedDateISO = post.data.updatedDate?.toISOString();
---

<BaseLayout
  title={`${post.data.title} | KJH Dev`}
  description={post.data.description}
  lang={lang}
  type="article"
  koUrl={koPost ? `/ko/posts/${slug}/` : undefined}
  enUrl={enPost ? `/en/posts/${slug}/` : undefined}
>
  <article class="article">
    <nav class="article-breadcrumb" aria-label={lang === 'ko' ? '현재 위치' : 'Breadcrumb'}>
      <a href={lang === 'ko' ? '/' : '/en/'}>{lang === 'ko' ? '홈' : 'Home'}</a>
      <span aria-hidden="true">›</span>
      <a href={post.data.postType === 'project' ? `/${lang}/projects/` : `/${lang}/notes/`}>
        {post.data.postType === 'project'
          ? (lang === 'ko' ? '프로젝트' : 'Projects')
          : (lang === 'ko' ? '개발노트' : 'Notes')}
      </a>
      {post.data.postType === 'project' && categoryHref && (
        <>
          <span aria-hidden="true">›</span>
          <a href={categoryHref}>{lang === 'ko' ? '시리즈 전체보기' : 'Full series'}</a>
        </>
      )}
    </nav>
    <header class="article-header">
      {post.data.category && (
        <a class="article-category" href={categoryHref}>
          {post.data.category}
        </a>
      )}
      <h1 class="article-title">{post.data.title}</h1>
      <div class="article-date">
        <span>{lang === 'ko' ? '작성' : 'Published'}: <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time></span>
        {modifiedDate && modifiedDateISO && <span> · {lang === 'ko' ? '수정' : 'Updated'}: <time datetime={modifiedDateISO}>{modifiedDate}</time></span>}
      </div>
      <div class="article-byline">{lang === 'ko' ? '작성자' : 'Author'}: <a href={`/${lang}/about/`}>KJH Dev</a></div>
      {post.data.tags.length > 0 && (
        <div class="article-tags">
          {post.data.tags.map((tag) => <span class="article-tag">#{tag}</span>)}
        </div>
      )}
    </header>
    <div class="article-body"><Content /></div>
    {projectSeries.length > 1 && post.data.project && (
      <nav class="series-navigation" aria-label={lang === 'ko' ? '프로젝트 시리즈 이동' : 'Project series navigation'}>
        <a class="series-navigation-all" href={`/${lang}/projects/${post.data.project}/`}>
          {lang === 'ko' ? '프로젝트 전체 목차' : 'View the full project series'}
        </a>
        <div class="series-navigation-links">
          {previousProjectPost ? (
            <a href={`/${lang}/posts/${previousProjectPost.id.split('/').pop()}/`}>
              <span>{lang === 'ko' ? '← 이전 글' : '← Previous'}</span>
              <strong>{previousProjectPost.data.title}</strong>
            </a>
          ) : <span aria-hidden="true"></span>}
          {nextProjectPost ? (
            <a href={`/${lang}/posts/${nextProjectPost.id.split('/').pop()}/`}>
              <span>{lang === 'ko' ? '다음 글 →' : 'Next →'}</span>
              <strong>{nextProjectPost.data.title}</strong>
            </a>
          ) : <span aria-hidden="true"></span>}
        </div>
      </nav>
    )}
    {relatedPosts.length > 0 && (
      <aside class="related-posts" aria-label={lang === 'ko' ? '관련 글' : 'Related posts'}>
        <h2>{lang === 'ko' ? '같이 보면 좋은 글' : 'Related posts'}</h2>
        <div class="related-post-list">
          {relatedPosts.map((item) => {
            const relatedSlug = item.id.split('/').pop();
            return (
              <a href={`/${lang}/posts/${relatedSlug}/`}>
                <strong>{item.data.title}</strong>
                <span>{item.data.description}</span>
              </a>
            );
          })}
        </div>
      </aside>
    )}
  </article>
</BaseLayout>
