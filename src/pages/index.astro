---
const siteUrl = 'https://kjhdev.github.io';
const imageUrl = `${siteUrl}/images/og-default.png`;
const description = '개발 경험과 문제 해결 과정을 기록하는 개발 블로그입니다.';
---

<!doctype html>
<html lang="ko">
  <head>
    <!-- 기본 메타 -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="google-site-verification" content="bolJzl6qQmXbFkaP1RzWqIlA5pugOw9Jj0N4h8_ROtY" />
    <meta name="naver-site-verification" content="db74ee1cd397ac7218cc3ca5d87cd9f32545d98a" />
    <meta name="robots" content="noindex, follow" />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3227222245611825" crossorigin="anonymous"></script>

    <title>KJH Dev</title>
    <meta name="description" content={description} />

    <!-- App Icons -->
    <link rel="icon" type="image/png" href="/gg.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#fcfaf1" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="KJH Dev" />

    <!-- Open Graph -->
    <meta property="og:title" content="KJH Dev" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="KJH Dev" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="KJH Dev" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- 언어별 홈으로 이동 -->
    <script is:inline>
      const language = navigator.language.toLowerCase();

      if (language.startsWith('ko')) {
        window.location.replace('/ko/');
      } else {
        window.location.replace('/en/');
      }
    </script>
  </head>

  <body></body>
</html>