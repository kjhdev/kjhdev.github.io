---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { extractFirstPostImage } from '../utils/postImage';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.lang === 'ko' && !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const latestNotes = posts.filter((post) => post.data.postType !== 'project').slice(0, 5);
const featuredProject = projects[0];
const projectPosts = featuredProject
  ? posts.filter((post) => post.data.postType === 'project' && post.data.project === featuredProject.id)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
---

<BaseLayout
  title="KJH Dev | 개발 프로젝트와 문제 해결 기록"
  description="직접 개발하고 운영한 서비스의 설계, 장애 원인, 해결 방법과 검증 결과를 기록하는 개발 블로그입니다."
  lang="ko"
>
  <section class="hero landing-hero">
    <p class="landing-eyebrow">KJH DEV · DEVELOPMENT JOURNAL</p>
    <h1>직접 만든 서비스와<br />문제 해결의 기록</h1>
    <p>
      Spring Boot, Node.js, MySQL, Flutter와 서버 운영까지.
      실제로 개발하고 운영하며 겪은 문제를 원인, 수정 과정, 검증 결과와 함께 정리합니다.
    </p>
    <div class="landing-actions">
      <a class="landing-primary-link" href="/ko/projects/">프로젝트 살펴보기 <span aria-hidden="true">→</span></a>
      <a class="landing-secondary-link" href="/ko/notes/">개발노트 전체보기 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  {featuredProject && (
    <section class="landing-section" aria-labelledby="featured-project-title">
      <div class="landing-section-heading">
        <h2 id="featured-project-title">진행 중인 프로젝트</h2>
        <a href="/ko/projects/">모든 프로젝트 보기 <span aria-hidden="true">→</span></a>
      </div>
      <a class="landing-feature" href={`/ko/projects/${featuredProject.id}/`}>
        <div class="landing-feature-content">
          <span class="project-status">{featuredProject.status.ko}</span>
          <h3>{featuredProject.title.ko}</h3>
          <p>{featuredProject.description.ko}</p>
          <span class="landing-feature-link">개발 기록 {projectPosts.length}개 보기 <span aria-hidden="true">→</span></span>
        </div>
        <div class="landing-feature-aside">
          <strong>기록하는 과정</strong>
          <p>데이터 수집과 검증, 저장 구조, 자동화 및 운영 중 겪은 문제를 실제 구현 흐름에 맞춰 정리합니다.</p>
        </div>
      </a>
      {projectPosts.length > 0 && (
        <div class="landing-series">
          <h3>프로젝트 개발 기록</h3>
          <ol>
            {projectPosts.slice(0, 3).map((post) => (
              <li>
                <a href={`/ko/posts/${post.id.split('/').pop()}/`}>{post.data.title}</a>
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>
  )}

  <section class="landing-section" aria-labelledby="latest-notes-title">
    <div class="landing-section-heading">
      <h2 id="latest-notes-title">최근 개발노트</h2>
      <a href="/ko/notes/">전체 글 보기 <span aria-hidden="true">→</span></a>
    </div>
    {latestNotes.length === 0 ? (
      <p>아직 공개된 개발노트가 없습니다.</p>
    ) : (
      <div class="post-list">
        {latestNotes.map((post) => {
          const slug = post.id.split('/').pop();
          const thumbnail = extractFirstPostImage(post.body);
          return (
            <a class:list={['post-card', { 'has-thumbnail': !!thumbnail }]} href={`/ko/posts/${slug}/`}>
              {thumbnail && (
                <div class="post-card-thumbnail" aria-hidden="true">
                  <img src={thumbnail} alt="" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="post-card-content">
                <h3 class="post-title">{post.data.title}</h3>
                <p class="post-description">{post.data.description}</p>
                <div class="post-meta">{post.data.pubDate.toLocaleDateString('ko-KR')} {post.data.category && ` · ${post.data.category}`}</div>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </section>

  <section class="landing-about" aria-labelledby="landing-about-title">
    <h2 id="landing-about-title">이 블로그는 어떤 기록을 남기나요?</h2>
    <p>
      단순한 사용법 소개보다, 어떤 환경에서 문제가 생겼고 무엇을 확인해 해결했는지에 집중합니다.
      재현 가능한 설정과 코드, 검증 기준을 남겨 비슷한 상황에서 다시 참고할 수 있는 자료를 만들고자 합니다.
    </p>
    <a href="/ko/about/">블로그 소개 읽기 <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
